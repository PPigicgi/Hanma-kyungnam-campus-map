# Default: Data Ieum-style harness using this PC's existing Codex login.
# No API key needed. Model override is local to this app, explicitly requested by user.
CAMPUS_LLM_MODE=codex
CAMPUS_CODEX_MODEL=gpt-6-luna
CAMPUS_REQUEST_TIMEOUT_SECONDS=600
# Optional alternative: CAMPUS_LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
# Set CAMPUS_LLM_MODE=off for offline source-only mode.
# These app settings never modify global Codex configuration.
